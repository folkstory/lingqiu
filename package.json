{
    "private": true,
    "scripts": {
        "docsify:serve": "node_modules/.bin/docsify serve ./",
        "install:latest": "npm outdated && npm install @lint-md/cli@latest docsify-cli@latest zhlint@latest && npm outdated",
        "lint-md": "node_modules/.bin/lint-md --suppress-warnings *.md */*.md */*/*.md",
        "lint-md:fix": "node_modules/.bin/lint-md --suppress-warnings --fix *.md */*.md */*/*.md",
        "zhlint": "node_modules/.bin/zhlint '{,*/,*/*/}*.md'",
        "zhlint:fix": "node_modules/.bin/zhlint '{,*/,*/*/}*.md' --fix"
    },
    "dependencies": {
        "@lint-md/cli": "^2.4.0",
        "docsify-cli": "^5.0.0",
        "zhlint": "^0.8.2"
    },
    "allowScripts": {
        "docsify@5.0.0": true,
        "fsevents@2.3.3": true
    }
}
